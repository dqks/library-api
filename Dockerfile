# Этап 1 - сборка приложения
# Первый этап multi-stage сборки, где в качестве базового окружения
# Берется официальный образ языка Go
FROM golang:1.26-alpine AS builder

# Аналог cd /app
# Все последущие команды выполняются относительно /app
WORKDIR /app

# Копируем только go.mod и go.sum в текущую директорию (/app)
COPY go.mod go.sum ./
RUN go mod download

# Затем уже только копируем все остальные файлы, которые не попадают в dockerignore
# Такое разбиение копирования делается для Docker cache
# Допустим, изменился только один handler. Если go.mod не изменился - значит Docker может использовать
# Закэшированный слой с зависимостями и не скачивать их заново
COPY . .

# Тут мы:
# Отключаем CGO, без которого компилятор создает статически связанный бинарник и является самодостаточным и не зависит от системных библиотек
# GOOS=linux мы говорим собрать под ОС Linux
# go build -o /library-api говорим сделать билд сервиса в /library-api
# ./cmd/api - исходник, откуда нужно сделать билд
RUN CGO_ENABLED=0 GOOS=linux go build -o /library-api ./cmd/api

# Этап 2 - контейнер, в котором приложение будет работать
# Создаем абсолютно чистый контейнер на базе Alpine Linux 3.24
FROM alpine:3.24

# Создаем папку app и делаем ее рабочей
WORKDIR /app

# Тут мы говорим
# Сходи в контейнер первого этапа (builder) и возьми оттуда файл
# Берется готовый бинарник /library-api и копирует его в /app/library-api 
COPY --from=builder /library-api /app/library-api

# Сообщаем Docker что приложение внутри контейнера слушает порт 8080
EXPOSE 8080

CMD ["/app/library-api"]

# Два FROM нужен для multi-stage build. 
# Первый image содержит Go compiler и используется только для сборки
# Во второй image попадает только бинарник, поэтому
# финальный image не тащит с собой компилятор, исходники и build dependencies

# Затем, чтобы собрать только контейнер для Go мы должны выполнить команду
# docker build -t library-api .
# docker build - сборка нового образа, которая выполняет команды из Dockerfile
# -t library-api - помечаем образ названием, вместо id по дефолту
# . - показываем, что все Dockerfile и все файлы для копирования находятся внутри католога
